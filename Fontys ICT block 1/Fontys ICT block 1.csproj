<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Fontys_ICT_block_1</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Ad images compiled straight into the assembly (not copied loosely next
    to the exe), so a published exe has everything it needs on its own -
    see BonusAdsResourcePrefix in MainWindow.xaml.cs for how they're read
    back out at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Ads\**" />
  </ItemGroup>

</Project>
