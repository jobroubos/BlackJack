<UserControl x:Class="Fontys_ICT_block_1.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="84" Height="118" Margin="0,0,10,10">

    <!--
        A reusable "playing card" visual with two faces: FrontFace (rank +
        suit) and BackFace (a plain card back). Only one is visible at a
        time - see CardControl.xaml.cs. Used for both the player's and the
        dealer's hand, and for the dealer's hidden hole card.
    -->
    <Grid>
        <Border x:Name="FrontFace"
                Background="White"
                BorderBrush="#B0B0B0"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Grid Margin="6">
                <TextBlock x:Name="TopRankText"
                           FontSize="19"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <TextBlock x:Name="SuitText"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="BottomRankText"
                           FontSize="19"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border x:Name="BackFace"
                Background="#1D3557"
                BorderBrush="#0D1B2A"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Border Margin="7" BorderBrush="#457B9D" BorderThickness="2" CornerRadius="5"/>
        </Border>
    </Grid>
</UserControl>
