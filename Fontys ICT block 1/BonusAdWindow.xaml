<Window x:Class="Fontys_ICT_block_1.BonusAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bonus!"
        Height="600" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#0F2E1A">

    <!--
        A rewarded-ad style popup: no title bar / X button at all
        (WindowStyle="None"), and the only Close button stays disabled
        until the countdown in BonusAdWindow.xaml.cs finishes. OnClosing
        there also cancels Alt+F4 / a taskbar close attempt while the
        countdown is still running, so this can't be dismissed early
        through any route.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Black"
                BorderBrush="#D4AF37"
                BorderThickness="2"
                CornerRadius="10"
                Margin="0,0,0,12">
            <Image x:Name="BonusImage" Stretch="Uniform" Margin="6"/>
        </Border>

        <Button x:Name="CloseButton"
                Grid.Row="1"
                Content="Close"
                IsEnabled="False"
                Height="46"
                FontWeight="Bold"
                FontSize="15"
                Foreground="#0F2E1A"
                Background="#D4AF37"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
